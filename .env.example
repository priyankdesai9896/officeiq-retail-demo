# OfficeIQ retail demo — local stack (Couchbase Server + Ollama + Agent Memory).
# scripts/setup.sh copies this to .env. The defaults match docker-compose.yml.

# Couchbase Server
CB_CONNECTION_STRING=couchbase://127.0.0.1
CB_USERNAME=Administrator
CB_PASSWORD=password
CB_BUCKET=retail
CB_MGMT_URL=http://127.0.0.1:8091

# Models — any OpenAI-compatible endpoint; Ollama by default
MODEL_ENDPOINT=http://127.0.0.1:11434/v1
MODEL_API_KEY=ollama
CHAT_MODEL=qwen2.5:3b
VISION_MODEL=qwen2.5vl:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMS=768

# Agent Memory server (optional — see README)
AGENT_MEMORY_URL=http://127.0.0.1:8082
AGENT_MEMORY_CONTAINER=officeiq-agentmemory

# Agent Catalog (agentc)
AGENT_CATALOG_CONN_STRING=couchbase://127.0.0.1
AGENT_CATALOG_USERNAME=Administrator
AGENT_CATALOG_PASSWORD=password
AGENT_CATALOG_BUCKET=retail
AGENT_CATALOG_EMBEDDING_MODEL_NAME=nomic-embed-text
AGENT_CATALOG_EMBEDDING_MODEL_URL=http://127.0.0.1:11434/v1
AGENT_CATALOG_EMBEDDING_MODEL_AUTH=ollama
