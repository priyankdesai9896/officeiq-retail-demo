# Agent Memory server settings. scripts/setup.sh copies this to agent-memory.env.
# The container reaches Couchbase and Ollama on the host via host.docker.internal.

AGENTMEMORY_CONN_STRING=couchbase://host.docker.internal
AGENTMEMORY_USERNAME=Administrator
AGENTMEMORY_PASSWORD=password
AGENTMEMORY_BUCKET=retail
AGENTMEMORY_MEMORY_BLOCK_TTL=0

# External (non-OpenAI) providers need *_URL and *_API_KEY. The server appends
# /v1 itself and detects the embedding dimension from a probe call.
AGENTMEMORY_EMBEDDING_MODEL=nomic-embed-text
AGENTMEMORY_EMBEDDING_URL=http://host.docker.internal:11434/v1
AGENTMEMORY_EMBEDDING_API_KEY=ollama
AGENTMEMORY_LLM_MODEL=llama3.2:1b
AGENTMEMORY_LLM_URL=http://host.docker.internal:11434/v1
AGENTMEMORY_LLM_API_KEY=ollama

# The server re-checks both models every 30s by default, each check a real
# completion. On CPU inference that steals time from every chat turn.
AGENTMEMORY_HEALTH_REFRESH_INTERVAL_SECONDS=1800
AGENTMEMORY_HEALTH_CACHE_TTL_SECONDS=3600

# Each model call has a hard-coded 30s timeout inside the server, and it runs up
# to 100 summaries at once by default. CPU inference serves them one or two at a
# time, so every queued call timed out and retried until it failed for good.
AGENTMEMORY_MAX_CONCURRENT_TASKS=8

AGENTMEMORY_SERVER_HOST=0.0.0.0
AGENTMEMORY_SERVER_PORT=8080
OIDC_AUTH_ENABLED=false
LOG_LEVEL=INFO
